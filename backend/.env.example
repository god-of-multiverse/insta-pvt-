# Copy to .env and fill in real values. Never commit .env.
#
# The previous .env was committed to this repository, so the credentials it
# held must be treated as public and rotated before any deployment.

# MongoDB connection string.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>

# Secret used to sign JWTs. Generate a fresh one, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing this invalidates all existing sessions, which is what you want
# after a leak.
JWT_SECRET=

PORT=5000
